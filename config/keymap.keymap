#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <16 17>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp Q      &kp W     &kp E     &kp R        &kp T                                &kp Y        &kp U  &kp I      &kp O      &kp P      &kp LBKT
&kp TAB    &kp A      &kp S     &kp D     &kp F        &kp G                                &kp H        &kp J  &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V        &kp B        &kp RBKT     &kp BSLH   &kp N        &kp M  &kp COMMA  &kp DOT    &kp FSLH   &kp INT_RO
&kp LCTRL  &kp RCTRL  &kp LGUI  &kp LALT  &lt 2 LANG2  &lt 1 SPACE  &lt 3 LANG1  &kp BSPC   &lt 1 ENTER  &none  &none      &kp MINUS  &kp EQUAL  &kp INT_YEN
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4            &kp N5                           &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &none
&trans  &none   &none   &none   &none             &none                            &kp PG_UP  &mkp LCLK  &mkp MCLK  &mkp RCLK  &mkp MCLK  &none
&trans  &none   &none   &none   &none             &none   &kp HOME        &kp END  &kp PG_DN  &mkp MB4   &none      &mkp MB5   &kp UP     &none
&trans  &trans  &trans  &trans  &kp INT_MUHENKAN  &trans  &kp INT_HENKAN  &kp DEL  &trans     &trans     &trans     &kp LEFT   &kp DOWN   &kp RIGHT
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp LS(N1)    &kp LS(N2)    &kp LS(N3)    &kp LS(N4)    &kp LS(N5)                    &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans      &trans      &trans      &trans      &trans      &trans
&trans  &trans        &trans        &out OUT_USB  &out OUT_BLE  &bt BT_NXT    &trans  &trans  &trans      &trans      &trans      &trans      &trans      &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                      &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11
&trans  &none   &none   &none   &none   &none                       &kp PG_UP  &mkp LCLK  &mkp MCLK  &mkp RCLK  &mkp MCLK  &kp F12
&trans  &none   &none   &none   &none   &none   &kp HOME  &kp END   &kp PG_DN  &mkp MB4   &none      &mkp MB5   &kp UP     &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &mkp MB4  &mkp MB5   &trans     &trans     &kp LEFT   &kp DOWN   &kp RIGHT
            >;
        };

        layer_4 {
            bindings = <
&trans  &none   &none   &none   &none   &none                  &none   &none      &none      &none      &none      &none
&trans  &none   &none   &none   &none   &none                  &none   &mkp LCLK  &mkp MCLK  &mkp RCLK  &mkp MCLK  &none
&trans  &none   &none   &none   &none   &none   &none   &none  &none   &mkp MB4   &none      &mkp MB5   &none      &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans     &trans     &none      &none      &none
            >;
        };
    };
};
